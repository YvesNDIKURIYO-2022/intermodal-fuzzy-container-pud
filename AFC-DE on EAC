def run_analysis(output_dir=None, seed=42, light_mode=False):
    overall_start = time.time()

    # Portable output directory
    if output_dir is None:
        output_dir = Path(os.environ.get("AFC_DE_OUTPUT_DIR", "./AFC-DE_EAC_results"))
    else:
        output_dir = Path(output_dir)
    out_dirs = setup_output_dirs(output_dir)

    np.random.seed(seed)
    rnd.seed(seed)

    if light_mode:
        runs = 2
        sens_runs, sens_pop, sens_gens = 1, 10, 20
    else:
        runs = 3
        sens_runs, sens_pop, sens_gens = 3, 15, 30
    pop, gens = 25, 60

    print("=" * 80)
    print("AFC-DE THREE-WAY COMPARISON ANALYSIS")
    print("2 hubs | 8 origins | 9 destinations | 6 borders | 4 vehicle types")
    print("=" * 80)
    print(f"Output:   {out_dirs['root']}")
    print(f"Workload: pop={pop}, gens={gens}, runs={runs}")
    print(f"Seed:     {seed}")
    print(f"Light:    {light_mode}")

    # ---- STEP 1: Greedy baseline ----
    print("\n" + "#" * 80)
    print("# STEP 1: GREEDY NEAREST-HUB BASELINE")
    print("#" * 80)
    greedy_sol = build_greedy_solution()
    print(f"  Base cost:     ${greedy_sol.base_cost:,.0f}")
    print(f"  Rel. penalty:  ${greedy_sol.reliability_penalty:,.0f}")
    print(f"  Total cost:    ${greedy_sol.total_cost:,.0f}")
    print(f"  TW violations: {greedy_sol.tw_violation_rate * 100:.2f}%")
    print(f"  Vehicles:      {greedy_sol.vehicle_summary.get('total_vehicles', 0)}")
    greedy_metrics = compute_metrics([greedy_sol])

    # ---- STEP 2: Deterministic-AFC-DE ----
    print("\n" + "#" * 80)
    print("# STEP 2: DETERMINISTIC-AFC-DE")
    print("#" * 80)
    det_results = run_deterministic_optimized(num_runs=runs, pop_size=pop, max_gen=gens)
    det_metrics = compute_metrics(det_results)
    print(f"\n  Best deterministic-AFC-DE total cost: ${det_metrics['total_cost']:,.0f} "
          f"(avg across {runs} runs)")
    print(f"  TW violations (MC):                   {det_metrics['tw_violation_rate'] * 100:.2f}%")

    # ---- STEP 3: Fuzzy-AFC-DE at four alpha values ----
    print("\n" + "#" * 80)
    print("# STEP 3: FUZZY-AFC-DE")
    print("#" * 80)
    fuzzy_results = {}
    fuzzy_metrics = {}
    for alpha in [0.50, 0.75, 0.90, 0.95]:
        results = run_fuzzy_alpha(alpha, num_runs=runs, pop_size=pop, max_gen=gens)
        fuzzy_results[alpha] = results
        fuzzy_metrics[alpha] = compute_metrics(results)
        gc.collect()

    # ---- STEP 4: Three-way comparison ----
    print("\n" + "#" * 80)
    print("# STEP 4: THREE-WAY COMPARISON")
    print("#" * 80)
    print(f"\n{'Method':<32} {'Base Cost':>12} {'Rel.Pen':>11} {'Total':>13} {'TW Viol':>9} {'Vehicles':>9}")
    print("-" * 95)
    print(f"{'Greedy nearest-hub':<32} ${greedy_metrics['base_cost']:>10,.0f} "
          f"${greedy_metrics['reliability_penalty']:>9,.0f} "
          f"${greedy_metrics['total_cost']:>11,.0f} "
          f"{greedy_metrics['tw_violation_rate'] * 100:>7.2f}% "
