# MONTE CARLO
# ============================================================================

def monte_carlo_evaluate(solution, n_samples=1000):
    violations_per_scenario = np.zeros(n_samples, dtype=bool)
    lateness_per_scenario   = np.zeros(n_samples)
    swvr_per_scenario       = np.zeros(n_samples)
    tw_widths_sum = 0.0
    n_valid = 0

    for dest, data in DESTINATIONS.items():
        hub = solution.hub_allocation.get(f"dest_{dest}")
        if hub is None:
            continue
        fuzzy = FUZZY_TRANSIT.get((hub, dest))
        if fuzzy is None:
            continue
        transit_samples = sample_trapezoidal_vectorized(fuzzy, n_samples)
        border_name = ROUTE_BORDER.get((hub, dest))
        if border_name:
            border_fuzzy = BORDER_CLEARANCE.get(border_name, (0, 0, 0, 0))
            border_samples = sample_trapezoidal_vectorized(border_fuzzy, n_samples)
            transit_samples += border_samples
            del border_samples

        tw_width = (data["latest_delivery"] - data["earliest_delivery"]) * solution.tw_tightness
        effective_deadline = data["earliest_delivery"] + (data["latest_delivery"] - data["earliest_delivery"]) * solution.tw_tightness
        excess = transit_samples - effective_deadline
        del transit_samples

        violations_per_scenario |= (excess > 0)
        lateness_per_scenario += np.maximum(excess, 0) * data["demand_teu"] / 50
        if tw_width > 0:
            swvr_per_scenario += np.maximum(excess, 0) / tw_width
        del excess

        tw_widths_sum += tw_width
        n_valid += 1

    if n_valid == 0:
        return {
            "tw_violation_rate": 0.0, "avg_lateness": 0.0, "swvr": 0.0,
            "normalized_lateness": 0.0, "cost_95": solution.base_cost,
            "cost_50": solution.base_cost, "robustness_index": 0.0,
        }

    tw_violation_rate = float(np.mean(violations_per_scenario))
    avg_lateness = float(np.mean(lateness_per_scenario))
    swvr = float(np.mean(swvr_per_scenario) / n_valid)
    avg_tw_width = tw_widths_sum / n_valid
    normalized_lateness = avg_lateness / avg_tw_width if avg_tw_width > 0 else 0.0

    lateness_cost = lateness_per_scenario * 1000
    cost_samples = solution.base_cost + lateness_cost
    cost_95 = float(np.percentile(cost_samples, 95))
    cost_50 = float(np.percentile(cost_samples, 50))
    robustness_index = (cost_95 - cost_50) / cost_50 if cost_50 > 0 else 0.0

    del violations_per_scenario, lateness_per_scenario, swvr_per_scenario, cost_samples

    return {
        "tw_violation_rate": tw_violation_rate, "avg_lateness": avg_lateness,
        "swvr": swvr, "normalized_lateness": normalized_lateness,
        "cost_95": cost_95, "cost_50": cost_50, "robustness_index": robustness_index,
    }


