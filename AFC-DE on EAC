def _timeout_handler(signum, frame):
    raise TimeoutError("savefig timed out")


def save_figure(fig, filename_base, out_dirs):
    """
    Save figure in Transportmetrica A standard formats.
    Each format is attempted independently; failures are logged but do not
    abort the script.
    """
    # --- Preview PNG (300 dpi) ---
    try:
        path_preview = out_dirs["figures"] / f"{filename_base}.png"
        fig.savefig(path_preview, dpi=300, format="png",
                    bbox_inches="tight", pad_inches=0.02)
        print("    [OK] preview PNG")
    except Exception as e:
        print(f"    [FAIL] preview PNG: {type(e).__name__}: {e}")

    # --- Publication PNG (600 dpi) ---
    try:
        path_png = out_dirs["figures_pub"] / f"{filename_base}.png"
        fig.savefig(path_png, dpi=600, format="png",
                    bbox_inches="tight", pad_inches=0.02)
        print("    [OK] publication PNG-600dpi")
    except Exception as e:
        print(f"    [FAIL] publication PNG: {type(e).__name__}: {e}")

    # --- Vector PDF ---
    try:
        path_pdf = out_dirs["figures_pub"] / f"{filename_base}.pdf"
        fig.savefig(path_pdf, format="pdf",
                    bbox_inches="tight", pad_inches=0.02)
        print("    [OK] publication PDF-vector")
    except Exception as e:
        print(f"    [FAIL] publication PDF: {type(e).__name__}: {e}")

    # --- Vector EPS (guarded with timeout on POSIX) ---
    eps_ok = False
    try:
        path_eps = out_dirs["figures_pub"] / f"{filename_base}.eps"
        use_alarm = hasattr(signal, "SIGALRM") and os.name == "posix"
        if use_alarm:
            old = signal.signal(signal.SIGALRM, _timeout_handler)
            signal.alarm(30)
        try:
            fig.savefig(path_eps, format="eps",
                        bbox_inches="tight", pad_inches=0.02)
            eps_ok = path_eps.exists() and path_eps.stat().st_size > 0
        finally:
            if use_alarm:
                signal.alarm(0)
                signal.signal(signal.SIGALRM, old)
        if eps_ok:
            print("    [OK] publication EPS")
        else:
            print("    [SKIP] EPS not produced (backend may have failed silently)")
    except Exception as e:
        print(f"    [FAIL] publication EPS: {type(e).__name__}: {e}")

    # --- TIFF (optional, requires Pillow) ---
    tiff_ok = False
    try:
        path_tiff = out_dirs["figures_pub"] / f"{filename_base}.tiff"
        fig.savefig(path_tiff, dpi=600, format="tiff",
                    bbox_inches="tight", pad_inches=0.02,
                    pil_kwargs={"compression": "tiff_lzw"})
        tiff_ok = path_tiff.exists() and path_tiff.stat().st_size > 0
        if tiff_ok:
            print("    [OK] publication TIFF-600dpi")
    except TypeError:
        try:
            fig.savefig(path_tiff, dpi=600, format="tiff",
                        bbox_inches="tight", pad_inches=0.02)
            print("    [OK] publication TIFF-600dpi (no LZW)")
        except Exception as e2:
            print(f"    [FAIL] publication TIFF (fallback): {type(e2).__name__}: {e2}")
    except Exception as e:
        print(f"    [FAIL] publication TIFF: {type(e).__name__}: {e}")

    plt.close(fig)
    plt.close("all")
    gc.collect()

    status = []
    if (out_dirs["figures_pub"] / f"{filename_base}.png").exists():  status.append("PNG")
    if (out_dirs["figures_pub"] / f"{filename_base}.pdf").exists():  status.append("PDF")
    if eps_ok:  status.append("EPS")
    if tiff_ok: status.append("TIFF")
    print(f"  Saved {filename_base}: {', '.join(status) if status else 'NONE'}")


def transportmetrica_figsize(width="single", height=None, aspect=0.75):
    w = TM_SINGLE_WIDTH if width == "single" else TM_DOUBLE_WIDTH
    if height is None:
        height = w * aspect
    return (w, min(height, TM_MAX_HEIGHT))


def safe_figure_call(func, *args, **kwargs):
    """Run a figure function; catch BaseException (except KeyboardInterrupt)."""
    try:
        func(*args, **kwargs)
    except KeyboardInterrupt:
        raise
    except BaseException as e:
        print(f"  [ERROR] {func.__name__} failed: {type(e).__name__}: {e}")
        traceback.print_exc()
    finally:
        plt.close("all")
        gc.collect()


