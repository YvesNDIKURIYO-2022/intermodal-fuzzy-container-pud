# AFC-DE ALGORITHM
# ============================================================================

class AFCDE:
    def __init__(self, pop_size=50, max_gen=200, alpha=0.75, tw_tightness=1.0,
                 deterministic_mode=False):
        self.pop_size = pop_size
        self.max_gen = max_gen
        self.alpha = alpha
        self.tw_tightness = tw_tightness
        self.deterministic_mode = deterministic_mode
        self.F_init = 0.5
        self.CR_init = 0.9
        self.F = None
        self.CR = None
        self.population = []
        self.feasibility_history = []

    def _adapt_F_CR(self):
        tau1 = tau2 = 0.1
        F_l, F_u = 0.1, 0.9
        for i in range(self.pop_size):
            if rnd.random() < tau1:
                self.F[i] = F_l + rnd.random() * F_u
            if rnd.random() < tau2:
                self.CR[i] = rnd.random()

    def _mutate(self, i):
        idxs = [j for j in range(self.pop_size) if j != i]
        r1, r2, r3 = rnd.choice(idxs, 3, replace=False)
        x1, x2, x3 = self.population[r1], self.population[r2], self.population[r3]
        mutant = x1.copy()
        F = self.F[i]
        for key in x1.hub_allocation:
            if rnd.random() < F:
                mutant.hub_allocation[key] = x2.hub_allocation.get(key, x3.hub_allocation.get(key))
        return mutant

    def _crossover(self, target, mutant, i):
        trial = target.copy()
        CR = self.CR[i]
        j_rand = rnd.randint(0, len(target.hub_allocation))
        keys = list(target.hub_allocation.keys())
        for j, key in enumerate(keys):
            if rnd.random() < CR or j == j_rand:
                trial.hub_allocation[key] = mutant.hub_allocation.get(key, target.hub_allocation[key])
        trial.alpha = self.alpha
        trial.tw_tightness = self.tw_tightness
        trial.deterministic_mode = self.deterministic_mode
        trial.evaluate()
        return trial

    def _repair(self, solution):
        if solution.deterministic_mode:
            solution.evaluate()
            return solution
        if solution.uncertainty_mode != "fuzzy":
            return solution
        for dest, data in DESTINATIONS.items():
            hub = solution.hub_allocation.get(f"dest_{dest}")
            if hub is None:
                continue
            fuzzy_transit = FUZZY_TRANSIT.get((hub, dest))
            if fuzzy_transit is None:
                continue
            border_name = ROUTE_BORDER.get((hub, dest))
            border_fuzzy = BORDER_CLEARANCE.get(border_name, (0, 0, 0, 0)) if border_name else (0, 0, 0, 0)
            composite = fuzzy_add(fuzzy_transit, border_fuzzy)
            effective_deadline = data["earliest_delivery"] + (data["latest_delivery"] - data["earliest_delivery"]) * solution.tw_tightness
            nec = necessity_measure(composite, effective_deadline)
            if nec < solution.alpha:
                for alt_hub in HUBS.keys():
                    if alt_hub == hub:
                        continue
                    alt_fuzzy = FUZZY_TRANSIT.get((alt_hub, dest))
                    if alt_fuzzy is None:
                        continue
                    alt_border_name = ROUTE_BORDER.get((alt_hub, dest))
                    alt_border_fuzzy = BORDER_CLEARANCE.get(alt_border_name, (0, 0, 0, 0)) if alt_border_name else (0, 0, 0, 0)
                    alt_composite = fuzzy_add(alt_fuzzy, alt_border_fuzzy)
                    alt_nec = necessity_measure(alt_composite, effective_deadline)
                    if alt_nec >= solution.alpha:
                        solution.hub_allocation[f"dest_{dest}"] = alt_hub
                        break
        solution.evaluate()
        return solution

    def _fast_non_dominated_sort(self, population):
        for p in population:
            p.dominated_set = []
            p.domination_count = 0
            for q in population:
                if p.dominates(q):
                    p.dominated_set.append(q)
                elif q.dominates(p):
                    p.domination_count += 1
            p.rank = 0 if p.domination_count == 0 else -1
        fronts = []
        current = [p for p in population if p.rank == 0]
        while current:
            fronts.append(current)
            nxt = []
            for p in current:
                for q in p.dominated_set:
                    q.domination_count -= 1
                    if q.domination_count == 0:
                        q.rank = len(fronts)
                        nxt.append(q)
            current = nxt
        return fronts

    def _crowding_distance(self, front):
        n = len(front)
        if n <= 2:
            for p in front:
                p.crowding_distance = float("inf")
            return
        for p in front:
            p.crowding_distance = 0
        for obj in ["total_cost", "total_time"]:
            front.sort(key=lambda x: getattr(x, obj))
            mn = getattr(front[0], obj)
            mx = getattr(front[-1], obj)
            rng = mx - mn
            if rng > 0:
                front[0].crowding_distance = float("inf")
                front[-1].crowding_distance = float("inf")
                for i in range(1, n - 1):
                    d = getattr(front[i + 1], obj) - getattr(front[i - 1], obj)
                    front[i].crowding_distance += d / rng

    def _select_next_generation(self, combined):
        fronts = self._fast_non_dominated_sort(combined)
        new_pop = []
        for front in fronts:
            if len(new_pop) + len(front) <= self.pop_size:
                new_pop.extend(front)
            else:
                self._crowding_distance(front)
                front.sort(key=lambda x: -x.crowding_distance)
                new_pop.extend(front[: self.pop_size - len(new_pop)])
                break
        return new_pop

    def run(self):
        start_time = time.time()
        self.population = []
        for _ in range(self.pop_size):
            sol = EACSolution(
                alpha=self.alpha,
                uncertainty_mode="fuzzy",
                tw_tightness=self.tw_tightness,
                deterministic_mode=self.deterministic_mode,
            )
            sol.initialize_random()
            sol = self._repair(sol)
            self.population.append(sol)
        self.F  = np.full(self.pop_size, self.F_init)
        self.CR = np.full(self.pop_size, self.CR_init)

        for gen in range(self.max_gen):
            self._adapt_F_CR()
            offspring = []
            for i in range(self.pop_size):
                mutant = self._mutate(i)
                trial = self._crossover(self.population[i], mutant, i)
                trial = self._repair(trial)
                offspring.append(trial)
            combined = self.population + offspring
            self.population = self._select_next_generation(combined)
            for p in combined:
                p.dominated_set = []
            combined = None
            offspring = None
            if gen % 20 == 0:
                gc.collect()
            feasible_count = sum(1 for p in self.population if p.feasible)
            self.feasibility_history.append(feasible_count / self.pop_size)

        elapsed = time.time() - start_time
        pareto = [p for p in self.population if p.rank == 0]
        if not pareto:
            pareto = self.population
        return self.population, pareto, elapsed


