def make_fuzzy(nominal, delta=0.15):
    """Trapezoidal fuzzy number centred on a nominal value."""
    return (nominal * (1 - 2 * delta), nominal * (1 - delta),
            nominal * (1 + delta), nominal * (1 + 2 * delta))


