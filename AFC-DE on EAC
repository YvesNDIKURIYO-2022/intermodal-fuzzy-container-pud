        ("[7/13]  Hub Utilization",              fig7_hub_utilization,            (best_075,)),
        ("[8/13]  Transfer Decomposition",       fig8_transfer_decomposition,     (best_075,)),
        ("[9/13]  Route Breakdown",              fig9_route_breakdown,            (best_075,)),
        ("[10/13] Sensitivity Analysis",         fig10_sensitivity_analysis,      (sens_results,)),
        ("[11/13] Fuzzy Distribution",           fig11_fuzzy_distribution,        (best_075,)),
        ("[12/13] Vehicle Deployment",           fig12_vehicle_deployment,        (best_075,)),
        ("[13/13] Extended Network Map",         fig13_extended_network_map,      (best_075,)),
