def build_greedy_solution():
    sol = EACSolution(alpha=1.0, uncertainty_mode="crisp-expected",
                      deterministic_mode=True)
    hubs_list = list(HUBS.keys())
    for origin in ORIGINS.keys():
        best_hub = min(hubs_list, key=lambda h: DISTANCES.get((origin, h), 10000))
        sol.hub_allocation[f"origin_{origin}"] = best_hub
    for dest in DESTINATIONS.keys():
        best_hub = min(hubs_list, key=lambda h: DISTANCES.get((h, dest), 10000))
        sol.hub_allocation[f"dest_{dest}"] = best_hub
    sol.evaluate()
    sol.extract_routes()

    mc = monte_carlo_evaluate(sol, n_samples=1000)
    sol.tw_violation_rate  = mc["tw_violation_rate"]
    sol.avg_lateness       = mc["avg_lateness"]
    sol.swvr               = mc["swvr"]
    sol.normalized_lateness = mc["normalized_lateness"]
    sol.mc_cost_95         = mc["cost_95"]
    sol.mc_cost_50         = mc["cost_50"]
    sol.robustness_index   = mc["robustness_index"]
    sol.reliability_penalty = (mc["tw_violation_rate"] * RELIABILITY_PENALTY_PER_HOUR_PER_TEU * TOTAL_DEMAND_TEU
                               + mc["avg_lateness"] * 1000)
    sol.total_cost = sol.base_cost + sol.reliability_penalty
    return sol


def _finalize_solution(best, elapsed):
    best.extract_routes()
    mc = monte_carlo_evaluate(best, n_samples=1000)
    best.tw_violation_rate  = mc["tw_violation_rate"]
    best.avg_lateness       = mc["avg_lateness"]
    best.swvr               = mc["swvr"]
    best.normalized_lateness = mc["normalized_lateness"]
    best.mc_cost_95         = mc["cost_95"]
    best.mc_cost_50         = mc["cost_50"]
    best.robustness_index   = mc["robustness_index"]
    best.reliability_penalty = (mc["tw_violation_rate"] * RELIABILITY_PENALTY_PER_HOUR_PER_TEU * TOTAL_DEMAND_TEU
                                + mc["avg_lateness"] * 1000)
    best.total_cost = best.base_cost + best.reliability_penalty
    best.runtime = elapsed
    return best


def run_deterministic_optimized(num_runs=3, pop_size=25, max_gen=60):
    print("\n[Deterministic-AFC-DE]")
    results = []
    for run in range(num_runs):
        runner = AFCDE(
            pop_size=pop_size, max_gen=max_gen,
            alpha=1.0, tw_tightness=1.0,
            deterministic_mode=True,
        )
        pop, pareto, elapsed = runner.run()
        feasible_pop = [p for p in pop if p.feasible]
        best = (max(feasible_pop, key=lambda x: x.hub_balance) if feasible_pop
                else max(pop, key=lambda x: (x.feasible, x.hub_balance)))
        _finalize_solution(best, elapsed)
        results.append(best)
        print(f"  Run {run + 1}: Base=${best.base_cost:,.0f}, "
              f"Rel.Pen=${best.reliability_penalty:,.0f}, Total=${best.total_cost:,.0f}, "
              f"TW_Viol={best.tw_violation_rate * 100:.2f}%, Veh={best.vehicle_summary.get('total_vehicles', 0)}, "
              f"Time={elapsed:.2f}s")
        gc.collect()
    return results


def run_fuzzy_alpha(alpha, num_runs=3, pop_size=25, max_gen=60, tw_tightness=1.0):
    print(f"\n[Fuzzy-AFC-DE alpha = {alpha:.2f}, TW tightness = {tw_tightness:.2f}]")
    results = []
    for run in range(num_runs):
        runner = AFCDE(pop_size=pop_size, max_gen=max_gen, alpha=alpha,
                       tw_tightness=tw_tightness, deterministic_mode=False)
        pop, pareto, elapsed = runner.run()
        feasible_pop = [p for p in pop if p.feasible]
        best = (max(feasible_pop, key=lambda x: x.hub_balance) if feasible_pop
                else max(pop, key=lambda x: (x.feasible, x.hub_balance)))
        _finalize_solution(best, elapsed)
        results.append(best)
        print(f"  Run {run + 1}: Base=${best.base_cost:,.0f}, "
              f"Rel.Pen=${best.reliability_penalty:,.0f}, Total=${best.total_cost:,.0f}, "
              f"TW_Viol={best.tw_violation_rate * 100:.2f}%, Veh={best.vehicle_summary.get('total_vehicles', 0)}, "
              f"Time={elapsed:.2f}s")
        gc.collect()
    return results


def compute_metrics(solutions):
    if not solutions:
        return {}
    base = {
        "base_cost":              np.mean([s.base_cost for s in solutions]),
        "base_cost_std":          np.std([s.base_cost for s in solutions], ddof=1) if len(solutions) > 1 else 0.0,
        "reliability_penalty":    np.mean([s.reliability_penalty for s in solutions]),
        "total_cost":             np.mean([s.total_cost for s in solutions]),
        "total_cost_std":         np.std([s.total_cost for s in solutions], ddof=1) if len(solutions) > 1 else 0.0,
        "cost_per_teu":           np.mean([s.cost_per_teu for s in solutions]),
        "hub_balance":            np.mean([s.hub_balance for s in solutions]),
        "gini_coefficient":       np.mean([s.gini_coefficient for s in solutions]),
        "inter_hub_flow":         np.mean([s.inter_hub_flow for s in solutions]),
        "inter_hub_imbalance":    np.mean([s.inter_hub_imbalance for s in solutions]),
        "inter_hub_spatial":      np.mean([s.inter_hub_spatial for s in solutions]),
        "transfer_efficiency":    np.mean([s.transfer_efficiency for s in solutions]),
        "hub_proximity":          np.mean([s.hub_proximity for s in solutions]),
        "proximity_efficiency":   np.mean([s.proximity_efficiency for s in solutions]),
        "co2_emissions":          np.mean([s.co2_emissions for s in solutions]),
        "pud_feasible":           np.mean([1.0 if s.pud_feasible else 0.0 for s in solutions]),
        "precedence_feasibility": np.mean([1.0 if s.precedence_feasibility else 0.0 for s in solutions]),
        "tw_violation_rate":      np.mean([s.tw_violation_rate for s in solutions]),
        "swvr":                   np.mean([s.swvr for s in solutions]),
        "avg_lateness":           np.mean([s.avg_lateness for s in solutions]),
        "normalized_lateness":    np.mean([s.normalized_lateness for s in solutions]),
        "credibility_satisfaction": np.mean([s.credibility_satisfaction for s in solutions]),
        "min_credibility":        np.mean([s.min_credibility for s in solutions]),
        "robustness_index":       np.mean([s.robustness_index for s in solutions]),
        "ciw":                    np.mean([s.ciw for s in solutions]),
        "chance_violations":      np.mean([s.chance_violations for s in solutions]),
        "feasible_rate":          np.mean([1.0 if s.feasible else 0.0 for s in solutions]),
        "runtime":                np.mean([getattr(s, "runtime", 0) for s in solutions]),
    }
    veh_solutions = [s for s in solutions if getattr(s, "vehicle_summary", {})]
    if veh_solutions:
        base["total_vehicles"]        = np.mean([s.vehicle_summary["total_vehicles"] for s in veh_solutions])
        base["weighted_utilization"]  = np.mean([s.vehicle_summary["weighted_utilization"] for s in veh_solutions])
        base["trucks_40ft"]           = np.mean([s.vehicle_summary["by_vehicle_type"].get("truck_40ft", 0) for s in veh_solutions])
        base["rail_wagons"]           = np.mean([s.vehicle_summary["by_vehicle_type"].get("rail_wagon", 0) for s in veh_solutions])
        base["lake_barges"]           = np.mean([s.vehicle_summary["by_vehicle_type"].get("lake_barge", 0) for s in veh_solutions])
    return base


