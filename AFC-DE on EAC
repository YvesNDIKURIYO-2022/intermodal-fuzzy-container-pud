        self.dominated_set = []
        self.domination_count = 0
        self.runtime = 0.0
        self.vehicle_deployment = {}
        self.vehicle_summary = {}

    def initialize_random(self):
        hubs = list(HUBS.keys())
        for origin in ORIGINS.keys():
            self.hub_allocation[f"origin_{origin}"] = rnd.choice(hubs)
        for dest in DESTINATIONS.keys():
            self.hub_allocation[f"dest_{dest}"] = rnd.choice(hubs)
        self.alpha = rnd.uniform(0.5, 1.0)
        self.evaluate()

    def evaluate(self):
        hubs_list = list(HUBS.keys())
        total_teu = sum(o["supply_teu"] for o in ORIGINS.values())

        transport_cost = 0.0
        for key, hub in self.hub_allocation.items():
            if key.startswith("origin_"):
                origin = key.replace("origin_", "")
                dist = DISTANCES.get((origin, hub), 1000)
                transport_cost += ORIGINS[origin]["supply_teu"] * dist * COST_PER_KM
            elif key.startswith("dest_"):
                dest = key.replace("dest_", "")
                dist = DISTANCES.get((hub, dest), 1000)
                transport_cost += DESTINATIONS[dest]["demand_teu"] * dist * COST_PER_KM
        self.transport_cost = transport_cost

        fuel_cost = 0.0
        for key, hub in self.hub_allocation.items():
            if key.startswith("origin_"):
                origin = key.replace("origin_", "")
                dist = DISTANCES.get((origin, hub), 1000)
                fuel_cost += ORIGINS[origin]["supply_teu"] * dist * FUEL_COST_PER_KM / 2
            elif key.startswith("dest_"):
                dest = key.replace("dest_", "")
                dist = DISTANCES.get((hub, dest), 1000)
                fuel_cost += DESTINATIONS[dest]["demand_teu"] * dist * FUEL_COST_PER_KM / 2
        self.fuel_cost = fuel_cost

        handling_cost = 0.0
        for hub in hubs_list:
            origin_teu = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS
                             if self.hub_allocation.get(f"origin_{o}") == hub)
            dest_teu = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS
                           if self.hub_allocation.get(f"dest_{d}") == hub)
            handling_cost += (origin_teu + dest_teu) * HUBS[hub]["handling_cost_per_teu"]
        self.handling_cost = handling_cost

        hub_flows = {}
        for hub in hubs_list:
            origin_teu = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS
                             if self.hub_allocation.get(f"origin_{o}") == hub)
            dest_teu = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS
                           if self.hub_allocation.get(f"dest_{d}") == hub)
            hub_flows[hub] = origin_teu - dest_teu
        self.inter_hub_flow = sum(abs(v) for v in hub_flows.values()) / 2
        self.transfer_cost = self.inter_hub_flow * INTER_HUB_TRANSFER_COST

        total_supply = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS)
        total_demand = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS)
        self.inter_hub_imbalance = abs(total_supply - total_demand)
        self.inter_hub_spatial = max(0, self.inter_hub_flow - self.inter_hub_imbalance)
        self.transfer_efficiency = (self.inter_hub_imbalance / self.inter_hub_flow
                                    if self.inter_hub_flow > 0 else 0.0)

        fixed_cost = (total_teu / 50) * VEHICLE_FIXED_COST
        self.base_cost = (transport_cost + fuel_cost + handling_cost
                          + self.transfer_cost + fixed_cost)

        total_time = 0.0
        for key, hub in self.hub_allocation.items():
            if key.startswith("origin_"):
                origin = key.replace("origin_", "")
                fuzzy = FUZZY_TRANSIT.get((origin, hub), (10.0, 11.0, 13.0, 15.0))
                total_time += fuzzy_expected(fuzzy)
            elif key.startswith("dest_"):
                dest = key.replace("dest_", "")
                fuzzy = FUZZY_TRANSIT.get((hub, dest), (20.0, 21.7, 25.0, 28.0))
                total_time += fuzzy_expected(fuzzy)

        border_delay = 0.0
        for dest, data in DESTINATIONS.items():
            hub = self.hub_allocation.get(f"dest_{dest}")
            if hub is None:
                continue
            border_name = ROUTE_BORDER.get((hub, dest))
            if border_name:
                border_fuzzy = BORDER_CLEARANCE.get(border_name, (0, 0, 0, 0))
                border_delay += fuzzy_expected(border_fuzzy) * data["demand_teu"] / total_teu
        self.border_delay = border_delay
        self.total_time = total_time + border_delay

        self.chance_violations = 0
        self.feasible = True
        self.credibility_satisfaction = 0.0
        self.min_credibility = 1.0
        ciw_sum = 0.0

        if self.deterministic_mode:
            self.credibility_satisfaction = 1.0
            self.min_credibility = 1.0
            self.ciw = 0.0
        elif self.uncertainty_mode == "fuzzy":
            for dest, data in DESTINATIONS.items():
                hub = self.hub_allocation.get(f"dest_{dest}")
                if hub is None:
                    continue
                fuzzy_transit = FUZZY_TRANSIT.get((hub, dest))
                if fuzzy_transit is None:
                    continue
                border_name = ROUTE_BORDER.get((hub, dest))
                border_fuzzy = BORDER_CLEARANCE.get(border_name, (0, 0, 0, 0)) if border_name else (0, 0, 0, 0)
                composite = fuzzy_add(fuzzy_transit, border_fuzzy)
                effective_deadline = data["earliest_delivery"] + (data["latest_delivery"] - data["earliest_delivery"]) * self.tw_tightness
                nec = necessity_measure(composite, effective_deadline)
                if nec >= self.alpha:
                    self.credibility_satisfaction += 1
                else:
                    self.chance_violations += 1
                if nec < self.min_credibility:
                    self.min_credibility = nec
                ciw_sum += (composite[3] - composite[0])
            n_dests = len(DESTINATIONS)
            self.credibility_satisfaction /= n_dests
            self.ciw = ciw_sum / n_dests
            if self.chance_violations > 0:
                self.feasible = False

        self.total_cost = self.base_cost
        self.cost_per_teu = self.total_cost / total_teu if total_teu > 0 else 0

        utils = []
        for hub in hubs_list:
            origin_teu = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS
                             if self.hub_allocation.get(f"origin_{o}") == hub)
            dest_teu = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS
                           if self.hub_allocation.get(f"dest_{d}") == hub)
            utils.append((origin_teu + dest_teu) / HUBS[hub]["capacity_teu"])

        if len(utils) > 1:
            sorted_u = np.sort(utils)
            n = len(sorted_u)
            self.gini_coefficient = (2 * np.sum(np.arange(1, n + 1) * sorted_u)
                                     / (n * np.sum(sorted_u))) - (n + 1) / n
            self.gini_coefficient = max(0, min(1, self.gini_coefficient))
            self.hub_balance = 1 - self.gini_coefficient
        else:
            self.gini_coefficient = 0
            self.hub_balance = 1.0

        proximity_sum = 0.0
        weight_sum = 0.0
        for origin in ORIGINS.keys():
            hub = self.hub_allocation.get(f"origin_{origin}")
            if hub:
                proximity_sum += ORIGINS[origin]["supply_teu"] * DISTANCES.get((origin, hub), 1000)
                weight_sum += ORIGINS[origin]["supply_teu"]
        self.hub_proximity = proximity_sum / weight_sum if weight_sum > 0 else 0

        min_proximity = 0.0
        for origin in ORIGINS.keys():
            min_dist = min(DISTANCES.get((origin, h), 1000) for h in hubs_list)
            min_proximity += ORIGINS[origin]["supply_teu"] * min_dist
        min_proximity /= weight_sum if weight_sum > 0 else 1
        self.proximity_efficiency = min_proximity / self.hub_proximity if self.hub_proximity > 0 else 1.0

        total_distance = 0.0
        for key, hub in self.hub_allocation.items():
            if key.startswith("origin_"):
                origin = key.replace("origin_", "")
                total_distance += DISTANCES.get((origin, hub), 1000)
            elif key.startswith("dest_"):
                dest = key.replace("dest_", "")
                total_distance += DISTANCES.get((hub, dest), 1000)
        self.co2_emissions = total_distance * CO2_PER_KM

        self.precedence_feasibility = True
        self.pud_feasible = self.feasible
        self.objectives = np.array([self.total_cost, self.total_time, -self.hub_balance])

    def extract_routes(self):
        hubs_list = list(HUBS.keys())
        self.origin_to_hub = {}
        for origin in ORIGINS.keys():
            hub = self.hub_allocation.get(f"origin_{origin}", hubs_list[0])
            self.origin_to_hub[origin] = {
                "hub": hub, "supply_teu": ORIGINS[origin]["supply_teu"],
                "distance": DISTANCES.get((origin, hub), 1000),
            }
        self.hub_to_destination = {}
        for dest in DESTINATIONS.keys():
            hub = self.hub_allocation.get(f"dest_{dest}", hubs_list[0])
            self.hub_to_destination[dest] = {
                "hub": hub, "demand_teu": DESTINATIONS[dest]["demand_teu"],
                "distance": DISTANCES.get((hub, dest), 1000),
            }
        self.hub_utilization = {}
        for hub in hubs_list:
            origin_teu = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS
                             if self.hub_allocation.get(f"origin_{o}") == hub)
            dest_teu = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS
                           if self.hub_allocation.get(f"dest_{d}") == hub)
            total_teu = origin_teu + dest_teu
            self.hub_utilization[hub] = {
                "origin_teu": origin_teu, "dest_teu": dest_teu,
                "total_teu": total_teu, "capacity": HUBS[hub]["capacity_teu"],
                "utilization_pct": (total_teu / HUBS[hub]["capacity_teu"]) * 100,
            }

        self.inter_hub_exchanges = {}
        flows = {}
        for hub in hubs_list:
            origin_teu = sum(ORIGINS[o]["supply_teu"] for o in ORIGINS
                             if self.hub_allocation.get(f"origin_{o}") == hub)
            dest_teu = sum(DESTINATIONS[d]["demand_teu"] for d in DESTINATIONS
                           if self.hub_allocation.get(f"dest_{d}") == hub)
            flows[hub] = origin_teu - dest_teu

        if len(hubs_list) == 2:
            h1, h2 = hubs_list[0], hubs_list[1]
            flow_1, flow_2 = flows[h1], flows[h2]
            total_flow = (abs(flow_1) + abs(flow_2)) / 2.0
            if flow_1 > 0:
                fwd_leg, rev_leg = f"{h1}->{h2}", f"{h2}->{h1}"
                fwd_amt = min(flow_1, abs(flow_2))
                rev_amt = total_flow - fwd_amt
            else:
                fwd_leg, rev_leg = f"{h2}->{h1}", f"{h1}->{h2}"
                fwd_amt = min(abs(flow_2), flow_1)
                rev_amt = total_flow - fwd_amt
            if fwd_amt > 0:
                self.inter_hub_exchanges[fwd_leg] = float(fwd_amt)
            if rev_amt > 0:
                self.inter_hub_exchanges[rev_leg] = float(rev_amt)
            self.inter_hub_flow = float(total_flow)

        self.vehicle_deployment = compute_vehicle_deployment(self)
        self.vehicle_summary = summarize_vehicle_deployment(self.vehicle_deployment)

    def dominates(self, other):
        if not self.feasible and other.feasible:
            return False
        if self.feasible and not other.feasible:
            return True
        if (self.total_cost <= other.total_cost
                and self.total_time <= other.total_time
                and self.hub_balance >= other.hub_balance):
            if (self.total_cost < other.total_cost
                    or self.total_time < other.total_time
                    or self.hub_balance > other.hub_balance):
                return True
        return False

    def copy(self):
        new = EACSolution(self.alpha, self.uncertainty_mode, self.tw_tightness,
                          self.deterministic_mode)
        new.hub_allocation = self.hub_allocation.copy()
        for attr in ["transport_cost", "fuel_cost", "transfer_cost", "handling_cost",
                     "base_cost", "total_cost", "cost_per_teu", "total_time", "border_delay",
                     "hub_balance", "gini_coefficient", "inter_hub_flow",
                     "inter_hub_imbalance", "inter_hub_spatial", "transfer_efficiency",
                     "hub_proximity", "proximity_efficiency", "co2_emissions",
                     "chance_violations", "feasible", "reliability_penalty",
                     "pud_feasible", "precedence_feasibility",
                     "tw_violation_rate", "swvr", "avg_lateness", "normalized_lateness",
                     "credibility_satisfaction", "min_credibility", "robustness_index",
                     "ciw", "mc_cost_95", "mc_cost_50", "runtime"]:
            setattr(new, attr, getattr(self, attr))
        for attr in ["hub_utilization", "origin_to_hub", "hub_to_destination",
                     "inter_hub_exchanges", "vehicle_deployment", "vehicle_summary"]:
            setattr(new, attr, getattr(self, attr).copy())
        new.objectives = self.objectives.copy() if self.objectives is not None else None
        return new


