def select_vehicle_type(arc_type, distance_km):
    if arc_type == "lake":
        candidates = ["lake_barge", "truck_40ft"]
    elif arc_type == "inter_hub":
        candidates = ["rail_wagon", "truck_40ft"]
    else:
        candidates = ["truck_40ft", "truck_20ft"]
    return min(candidates, key=lambda v: VEHICLE_TYPES[v]["cost_per_km"] / VEHICLE_TYPES[v]["capacity_teu"])


def compute_vehicle_deployment(solution):
    deployment = {}
    for origin, data in solution.origin_to_hub.items():
        hub = data["hub"]
        teu, dist = data["supply_teu"], data["distance"]
        vtype = select_vehicle_type("origin_hub", dist)
        vt = VEHICLE_TYPES[vtype]
        n = int(np.ceil(teu / vt["capacity_teu"]))
        util = teu / (n * vt["capacity_teu"])
        driving_h = dist / vt["speed_kmh"]
        deployment[(origin, hub)] = {
            "arc_type": "origin_hub", "flow_teu": float(teu), "distance_km": float(dist),
            "vehicle_type": vtype, "capacity_teu": vt["capacity_teu"], "count": n,
            "utilization": float(util), "driving_hours": float(driving_h),
            "days_required": int(np.ceil(driving_h / DRIVER_HOURS_PER_DAY)) if driving_h > 0 else 1,
        }
    for dest, data in solution.hub_to_destination.items():
        hub = data["hub"]
        teu, dist = data["demand_teu"], data["distance"]
        arc_type = "lake" if (hub, dest) in LAKE_ARCS else "hub_dest"
        vtype = select_vehicle_type(arc_type, dist)
        vt = VEHICLE_TYPES[vtype]
        n = int(np.ceil(teu / vt["capacity_teu"]))
        util = teu / (n * vt["capacity_teu"])
        driving_h = dist / vt["speed_kmh"]
        deployment[(hub, dest)] = {
            "arc_type": arc_type, "flow_teu": float(teu), "distance_km": float(dist),
            "vehicle_type": vtype, "capacity_teu": vt["capacity_teu"], "count": n,
            "utilization": float(util), "driving_hours": float(driving_h),
            "days_required": int(np.ceil(driving_h / DRIVER_HOURS_PER_DAY)) if driving_h > 0 else 1,
        }
    for leg, teu in solution.inter_hub_exchanges.items():
        i, j = leg.split("->")
        dist = DISTANCES.get((i, j), 450)
        vtype = select_vehicle_type("inter_hub", dist)
        vt = VEHICLE_TYPES[vtype]
        n = max(1, int(np.ceil(teu / vt["capacity_teu"])))
        util = teu / (n * vt["capacity_teu"])
        driving_h = dist / vt["speed_kmh"]
        deployment[(i, j)] = {
            "arc_type": "inter_hub", "flow_teu": float(teu), "distance_km": float(dist),
            "vehicle_type": vtype, "capacity_teu": vt["capacity_teu"], "count": n,
            "utilization": float(util), "driving_hours": float(driving_h),
            "days_required": int(np.ceil(driving_h / DRIVER_HOURS_PER_DAY)) if driving_h > 0 else 1,
        }
    return deployment


def summarize_vehicle_deployment(deployment):
    total_vehicles = 0
    total_capacity = 0
    total_flow = 0
    by_type = {}
    by_arc_type = {"origin_hub": 0, "inter_hub": 0, "hub_dest": 0, "lake": 0}
    for (i, j), d in deployment.items():
        total_vehicles += d["count"]
        total_capacity += d["count"] * d["capacity_teu"]
        total_flow += d["flow_teu"]
        by_type[d["vehicle_type"]] = by_type.get(d["vehicle_type"], 0) + d["count"]
        by_arc_type[d["arc_type"]] = by_arc_type.get(d["arc_type"], 0) + d["count"]
    weighted_util = total_flow / total_capacity if total_capacity > 0 else 0.0
    return {
        "total_vehicles": total_vehicles,
        "total_capacity_teu": total_capacity,
        "total_flow_teu": total_flow,
        "weighted_utilization": weighted_util,
        "by_vehicle_type": by_type,
        "by_arc_type": by_arc_type,
        "fleet_composition_pct": {
            k: 100.0 * v / total_vehicles if total_vehicles > 0 else 0.0
            for k, v in by_type.items()
        },
    }


