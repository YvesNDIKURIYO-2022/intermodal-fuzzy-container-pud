# ============================================================================

def fuzzy_expected(fuzzy_tuple):
    a1, a2, a3, a4 = fuzzy_tuple
    return (a1 + 2 * a2 + 2 * a3 + a4) / 6


def fuzzy_add(f1, f2):
    return (f1[0] + f2[0], f1[1] + f2[1], f1[2] + f2[2], f1[3] + f2[3])


def necessity_measure(fuzzy_tuple, bound):
    a1, a2, a3, a4 = fuzzy_tuple
    if bound >= a4:
        return 1.0
    elif bound >= a3:
        return (bound - a3) / (a4 - a3) if a4 > a3 else 1.0
    else:
        return 0.0


def sample_trapezoidal_vectorized(fuzzy_tuple, n_samples=1000):
    a, b, c, d = fuzzy_tuple
    u = rnd.random(n_samples)
    area_left  = max((b - a) / 2, 1e-9)
    area_mid   = max(c - b,      1e-9)
    area_right = max((d - c) / 2, 1e-9)
    total_area = area_left + area_mid + area_right
    cum_left = area_left / total_area
    cum_mid  = (area_left + area_mid) / total_area
    samples = np.zeros(n_samples)
    mask_left = u < cum_left
    if np.any(mask_left):
        samples[mask_left] = a + (b - a) * np.sqrt(u[mask_left] / cum_left)
    mask_mid = (u >= cum_left) & (u < cum_mid)
    if np.any(mask_mid):
        samples[mask_mid] = b + (c - b) * (u[mask_mid] - cum_left) / (cum_mid - cum_left)
    mask_right = u >= cum_mid
    if np.any(mask_right):
        samples[mask_right] = d - (d - c) * np.sqrt((1 - u[mask_right]) / (1 - cum_mid))
    return samples


